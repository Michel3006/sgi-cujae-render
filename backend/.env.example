# LDAP CUJAE (POST /auth/login-ldap)
LDAP_HOST=10.8.1.125
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_BIND_DN=vmail@cujae.edu.cu
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=dc=cujae,dc=edu,dc=cu
LDAP_USER_ATTRIBUTE=sAMAccountName
LDAP_USER_OBJECT_FILTER=(&(|(objectclass=person)(objectclass=user))(!(userAccountControl:1.2.840.113556.1.4.803:=2)))
LDAP_WORKER_ATTRIBUTE=employeeType
LDAP_WORKER_VALUE=trabajador
LDAP_VALIDATE_CERT=false
