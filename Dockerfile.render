# -----------------------------------------------------------------------------
# Dockerfile.render — Imagen para despliegue en Render (entorno de prueba)
# Multi-stage: construye el frontend con Node, luego empaqueta con Python
# -----------------------------------------------------------------------------

# =============================================================================
# Etapa 1: Construir el frontend (React + Vite)
# =============================================================================
FROM node:20-bookworm-slim AS frontend-build

WORKDIR /app/frontend

# Argumentos de build para las URLs de la API (se inyectan en tiempo de build)
ARG VITE_API_BASE_URL=/
ARG VITE_CHAT_API_BASE_URL=/
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_CHAT_API_BASE_URL=$VITE_CHAT_API_BASE_URL

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npx vite build

# =============================================================================
# Etapa 2: Imagen final — Python + Backend + Frontend estático
# =============================================================================
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Instalar dependencias del sistema (curl para healthcheck, ca-certificates)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar requirements e instalar dependencias Python
COPY backend/requirements.txt /tmp/backend-requirements.txt
RUN sed -i 's/^psycopg2==/psycopg2-binary==/' /tmp/backend-requirements.txt \
    && pip install --no-cache-dir -r /tmp/backend-requirements.txt \
    && pip install --no-cache-dir asyncpg==0.29.0 "pydantic-settings>=2.2.1" "python-multipart"

# Copiar código del backend y modelo
COPY backend/ /app/backend/
COPY model/ /app/model/
COPY db/ /app/db/

# Copiar frontend construido desde la etapa anterior
COPY --from=frontend-build /app/frontend/dist /app/backend/static/

# Crear directorio de uploads
RUN mkdir -p /app/backend/uploads

# Script de entrada para Render
COPY entrypoint_render.sh /entrypoint_render.sh
RUN sed -i 's/\r$//' /entrypoint_render.sh && chmod +x /entrypoint_render.sh

# Puerto de Render (variable $PORT inyectada por Render)
ENV PORT=8000

EXPOSE $PORT

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://127.0.0.1:${PORT}/ || exit 1

ENTRYPOINT ["/entrypoint_render.sh"]
