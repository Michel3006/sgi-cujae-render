# LM Studio (servidor de inferencia local)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=
DEFAULT_MODEL=local-model

# PostgreSQL: URL asyncpg (usuario recomendado: solo SELECT / solo lectura)
# Ejemplo: postgresql://lector:TU_PASSWORD@tu-servidor:5432/tu_base
DATABASE_URL=postgresql://postgres:1234@localhost:5432/sistema_unificado_c_c_q

# Archivo con descripción de tablas/columnas para text-to-SQL (ruta relativa o absoluta)
SQL_SCHEMA_CONTEXT_PATH=schema_context.txt

# Límite máximo de filas en cada consulta generada
SQL_MAX_ROWS=100
# Filas máximas enviadas al modelo en la segunda pasada (respuesta en lenguaje natural)
ASK_DATA_MAX_ROWS_IN_PROMPT=50
# Esquema en ask-data (caracteres). Con n_ctx=4096 en LM Studio usar ~5000–8000; sube si aumentas contexto del modelo.
# 0 = sin recorte
SQL_SCHEMA_MAX_CHARS=5500
# Tokens de salida del modelo en ask-data (debe caber en n_ctx)
ASK_DATA_MAX_TOKENS_SQL=384
ASK_DATA_MAX_TOKENS_ANSWER=768

# Rendimiento y anti-alucinación (recomendado para Llama 3.1 en demo)
ASK_DATA_USE_DETERMINISTIC_ANSWER=true
ASK_DATA_SCHEMA_ROUTING=true
ASK_DATA_SCHEMA_MAX_TABLES=15
ASK_DATA_TEMPERATURE_SQL_CAP=0.1
