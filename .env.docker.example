# =============================================================================
# Configuración de despliegue SGI — copia este archivo a .env y ajusta valores
# =============================================================================
#   cp .env.docker.example .env
#   docker compose up -d --build
# =============================================================================

# --- Puertos expuestos en el host (cámbialos si hay conflicto) ---
HTTP_PORT=8080
BACKEND_PORT=8000
MODEL_API_PORT=8001

# --- PostgreSQL (dentro del contenedor) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sgi_secret
POSTGRES_DB=sistema_unificado_c_c_q
DATABASE_URL=postgresql://postgres:sgi_secret@127.0.0.1:5432/sistema_unificado_c_c_q

# --- Backend SGI ---
BACKEND_CORS_ORIGINS=*

# --- LDAP CUJAE (login /auth/login-ldap) ---
LDAP_ENABLED=true
LDAP_HOST=10.8.1.125
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=dc=cujae,dc=edu,dc=cu
LDAP_VALIDATE_CERT=false

# --- Modelo IA: servidor de inferencia EXTERNO (LM Studio, Ollama, vLLM, etc.) ---
# El servicio modelo (puerto MODEL_API_PORT) consume esta API compatible con OpenAI.
#
# Ejemplos:
#   LM Studio en el mismo PC (Docker Desktop Windows/Mac):
#     LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
#   LM Studio en otra máquina de la red:
#     LM_STUDIO_BASE_URL=http://192.168.1.50:1234/v1
#   Servidor Linux (sin host.docker.internal):
#     LM_STUDIO_BASE_URL=http://172.17.0.1:1234/v1
#
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_API_KEY=
DEFAULT_MODEL=local-model

# Parámetros ask-data (opcional)
SQL_MAX_ROWS=100
ASK_DATA_MAX_ROWS_IN_PROMPT=50

# --- Zenodo (opcional) ---
ZENODO_API_URL=https://sandbox.zenodo.org
ZENODO_ACCESS_TOKEN=
